+/// Remove the live official login when switching to an empty official
+/// provider slot. CC Switch stores the outgoing provider's auth snapshot
+/// during backfill; deleting the live file makes Codex show its normal login
+/// flow so a second account can be authenticated into that slot.
+pub fn clear_codex_live_auth_for_empty_official_switch() -> Result<bool, AppError> {
+    let auth_path = get_codex_auth_path();
+    if !auth_path.exists() {
+        return Ok(false);
+    }
+    delete_file(&auth_path)?;
+    Ok(true)
+}
