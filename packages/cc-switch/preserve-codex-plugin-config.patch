 /// 原子写 Codex 的 `auth.json` 与 `config.toml`，在第二步失败时回滚第一步
+///
+/// Provider snapshots may predate the current OMX installation. Keep the
+/// live plugin and marketplace registrations when routing writes replace the
+/// provider's config text.
+fn preserve_codex_plugin_sections(config_path: &Path, candidate: &str) -> Result<String, AppError> {
+    if !config_path.exists() {
+        return Ok(candidate.to_string());
+    }
+
+    let mut candidate_doc = candidate
+        .parse::<DocumentMut>()
+        .map_err(|error| AppError::Message(format!("Invalid Codex config.toml: {error}")))?;
+    let current_text = fs::read_to_string(config_path)
+        .map_err(|error| AppError::io(config_path, error))?;
+    let Ok(current_doc) = current_text.parse::<DocumentMut>() else {
+        return Ok(candidate.to_string());
+    };
+
+    for key in ["plugins", "marketplaces"] {
+        if let Some(item) = current_doc.get(key) {
+            candidate_doc[key] = item.clone();
+        }
+    }
+
+    Ok(candidate_doc.to_string())
+}
+
 pub fn write_codex_live_atomic(
