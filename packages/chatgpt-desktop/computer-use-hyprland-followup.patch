+    /// Accept a negative/outside-capture Hyprland compositor coordinate when
+    /// it maps unambiguously into the current screenshot. The primary
+    /// contract remains screenshot coordinates; this compatibility path fixes
+    /// the common case where AT-SPI supplies a valid point on a monitor whose
+    /// compositor origin is negative.
+    async fn normalize_pointer_point(&self, x: i32, y: i32) -> (i32, i32, Option<String>) {
+        let Some((_, _, capture_width, capture_height)) = self.capture_space_rect().await else {
+            return (x, y, None);
+        };
+        let inside_capture = x >= 0 && y >= 0 && x < capture_width && y < capture_height;
+        if inside_capture
+            || (!env_contains("XDG_CURRENT_DESKTOP", "hyprland")
+                && !env_var_non_empty("HYPRLAND_INSTANCE_SIGNATURE"))
+        {
+            return (x, y, None);
+        }
+
+        let Some([mapped_x, mapped_y]) =
+            crate::windowing::backends::hyprland::capture_point_from_hyprland(
+                [x, y],
+                (capture_width as u32, capture_height as u32),
+            )
+            .await
+        else {
+            return (x, y, None);
+        };
+
+        (
+            mapped_x,
+            mapped_y,
+            Some(format!(
+                "Mapped Hyprland compositor coordinate {x},{y} to screenshot coordinate {mapped_x},{mapped_y}."
+            )),
+        )
+    }
+
diff --git a/computer-use-linux/src/windowing/backends/hyprland.rs b/computer-use-linux/src/windowing/backends/hyprland.rs
index 01c9535..77307d7 100644
--- a/computer-use-linux/src/windowing/backends/hyprland.rs
+++ b/computer-use-linux/src/windowing/backends/hyprland.rs
@@ -216,0 +217,12 @@ impl HyprlandCaptureLayout {
+    /// Convert a Hyprland compositor/global point back into the logical
+    /// screenshot space used by pointer input. This is intentionally separate
+    /// from `capture_point_to_hyprland`: callers should use it only after
+    /// determining that a point is outside the capture rectangle, because
+    /// positive coordinates can be valid in both spaces.
+    fn hyprland_point_to_capture(&self, point: [i32; 2]) -> Result<[i32; 2]> {
+        Ok([
+            self.hyprland_coordinate_to_capture(point[0], self.origin_x)?,
+            self.hyprland_coordinate_to_capture(point[1], self.origin_y)?,
+        ])
+    }
+
@@ -234,0 +247,8 @@ impl HyprlandCaptureLayout {
+    fn hyprland_coordinate_to_capture(&self, value: i32, origin: i32) -> Result<i32> {
+        let mapped = (f64::from(value) - f64::from(origin)) * self.scale;
+        if !mapped.is_finite() || mapped < f64::from(i32::MIN) || mapped > f64::from(i32::MAX) {
+            bail!("Hyprland coordinate {value} cannot be mapped to capture coordinates");
+        }
+        Ok(mapped.round() as i32)
+    }
+
@@ -379,0 +400,17 @@ async fn capture_layout() -> Result<HyprlandCaptureLayout> {
+/// Best-effort conversion for a negative/outside-capture coordinate supplied
+/// in Hyprland's compositor/global coordinate space. The normal public
+/// contract remains screenshot coordinates; this compatibility path exists
+/// for AT-SPI/window geometry values on monitors with negative origins.
+pub(crate) async fn capture_point_from_hyprland(
+    point: [i32; 2],
+    capture_size: (u32, u32),
+) -> Option<[i32; 2]> {
+    let layout = capture_layout().await.ok()?;
+    let mapped = layout.hyprland_point_to_capture(point).ok()?;
+    (mapped[0] >= 0
+        && mapped[1] >= 0
+        && mapped[0] < i32::try_from(capture_size.0).ok()?
+        && mapped[1] < i32::try_from(capture_size.1).ok()?)
+    .then_some(mapped)
+}
+
