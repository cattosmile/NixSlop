@@ -840,0 +898,18 @@ fn select_action_index(actions: &[atspi::Action], requested_action: Option<&str>
+fn is_primary_action_alias(action: &str) -> bool {
+    matches!(action, "click" | "activate" | "press")
+}
+
+fn action_has_no_name_or_description(action: &atspi::Action) -> bool {
+    action_metadata_is_empty(&action.name) && action_metadata_is_empty(&action.description)
+}
+
+fn action_metadata_is_empty(value: &str) -> bool {
+    value.trim().trim_matches(':').is_empty()
+}
+
+fn numeric_values_match(actual: f64, expected: f64) -> bool {
+    actual.is_finite()
+        && expected.is_finite()
+        && (actual - expected).abs() <= 1e-6_f64.max(expected.abs() * 1e-6)
+}
