+    fn capture_point_to_hyprland(&self, point: [i32; 2]) -> Result<[i32; 2]> {
+        Ok([
+            self.capture_coordinate_to_hyprland(point[0], self.origin_x)?,
+            self.capture_coordinate_to_hyprland(point[1], self.origin_y)?,
+        ])
+    }
+
+    fn capture_size_to_hyprland(&self, size: [u32; 2]) -> Result<[i32; 2]> {
+        Ok([
+            self.capture_extent_to_hyprland(size[0])?,
+            self.capture_extent_to_hyprland(size[1])?,
+        ])
+    }
+
+    fn capture_coordinate_to_hyprland(&self, value: i32, origin: i32) -> Result<i32> {
+        let mapped = f64::from(value) / self.scale + f64::from(origin);
+        if !mapped.is_finite()
+            || mapped < f64::from(i32::MIN)
+            || mapped > f64::from(i32::MAX)
+        {
+            bail!("capture coordinate {value} cannot be mapped to Hyprland coordinates");
+        }
+        Ok(mapped.round() as i32)
+    }
+
+    fn capture_extent_to_hyprland(&self, value: u32) -> Result<i32> {
+        let mapped = f64::from(value) / self.scale;
+        if !mapped.is_finite() || mapped < 1.0 || mapped > f64::from(i32::MAX) {
+            bail!("capture extent {value} cannot be mapped to a positive Hyprland size");
+        }
+        Ok(mapped.round().max(1.0) as i32)
+    }
