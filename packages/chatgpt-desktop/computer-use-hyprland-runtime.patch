+fn is_hyprland_session() -> bool {
+    let current_desktop = env::var("XDG_CURRENT_DESKTOP").ok();
+    let instance_signature = env::var("HYPRLAND_INSTANCE_SIGNATURE").ok();
+    is_hyprland_session_values(current_desktop.as_deref(), instance_signature.as_deref())
+}
+
+fn is_hyprland_session_values(
+    current_desktop: Option<&str>,
+    instance_signature: Option<&str>,
+) -> bool {
+    current_desktop.is_some_and(|desktop| {
+        desktop
+            .split(':')
+            .any(|value| value.trim().eq_ignore_ascii_case("hyprland"))
+    }) || instance_signature.is_some_and(|signature| !signature.trim().is_empty())
+}
+
+async fn native_window_targeting_report() -> WindowTargetingSetupReport {
+    let (windows, windows_error, permissions_hint) = match list_hyprland_windows().await {
+        Ok(windows) => (windows, None, None),
+        Err(error) => {
+            let error = format!("{error:#}");
+            let hint = window_permission_hint(&error);
+            (Vec::new(), Some(error), hint)
+        }
+    };
+    let (ok, detail, message) = match windows_error.as_deref() {
+        None => (
+            true,
+            "Hyprland hyprctl window backend is active; the GNOME Shell extension is not required."
+                .to_string(),
+            "Hyprland native window targeting is active; no GNOME Shell extension is required."
+                .to_string(),
+        ),
+        Some(error) => (
+            false,
+            format!("Hyprland hyprctl window backend unavailable: {error}"),
+            format!(
+                "Hyprland was detected, but native window targeting is unavailable: {error}"
+            ),
+        ),
+    };
+
+    WindowTargetingSetupReport {
+        extension_dir: "not applicable (Hyprland native backend)".to_string(),
+        wrote_files: false,
+        enable_command: SetupCommandReport { ok, detail },
+        windows,
+        windows_error,
+        permissions_hint,
+        requires_shell_reload: false,
+        message,
+    }
+}
