+async fn capture_layout() -> Result<HyprlandCaptureLayout> {
+    let output = hyprctl_output_async(&["monitors", "-j"])
+        .await
+        .context("failed to run hyprctl monitors -j for coordinate conversion")?;
+    if !output.status.success() {
+        bail!(
+            "hyprctl monitors -j failed: {}",
+            String::from_utf8_lossy(&output.stderr).trim()
+        );
+    }
+    let monitors: Vec<HyprlandMonitor> = serde_json::from_slice(&output.stdout)
+        .context("failed to parse hyprctl monitors -j for coordinate conversion")?;
+    HyprlandCaptureLayout::from_monitors(&monitors)
+        .ok_or_else(|| anyhow::anyhow!("Hyprland monitor metadata has no usable scale"))
