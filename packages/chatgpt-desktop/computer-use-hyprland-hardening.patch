+            wm_class: Some("kitty".to_string()),
+            title: Some("old title".to_string()),
+            ..Default::default()
+        };
+        let replacement = test_window(0x2222, Some(4242), Some("kitty"), Some("new title"));
+
+        let selected = select_replacement_window_for_target(&target, &[replacement]).unwrap();
+
+        assert_eq!(selected.window_id, 0x2222);
+    }
+
+    #[test]
+    fn refuses_to_guess_between_ambiguous_replacement_windows() {
+        let requested = test_window(0x1111, Some(4242), Some("kitty"), Some("old title"));
+        let first = test_window(0x2222, Some(4242), Some("kitty"), Some("first"));
+        let second = test_window(0x3333, Some(4242), Some("kitty"), Some("second"));
+
+        assert!(select_replacement_window(&requested, &[first, second]).is_none());
+    }
+
+    #[test]
+    fn recovers_without_pid_only_for_an_exact_identity_match() {
+        let requested = test_window(0x1111, None, Some("org.example.App"), Some("App"));
+        let replacement = test_window(0x2222, None, Some("org.example.App"), Some("App"));
+
+        let selected = select_replacement_window(&requested, &[replacement]).unwrap();
+
+        assert_eq!(selected.window_id, 0x2222);
+    }
+
+    #[test]
+    fn reports_when_geometry_used_a_recovered_window_handle() {
+        let requested = test_window(0x1111, Some(4242), Some("kitty"), Some("old title"));
+
+        let result = format_window_geometry_result(
+            "moved",
+            &requested,
+            0x2222,
+            true,
+            "capture position 10,20 (compositor position 10,20)".to_string(),
+        );
+
+        assert!(result.contains("Recovered stale window handle 0x1111 as 0x2222"));
+        assert!(result.ends_with('.'));
+    }
+
