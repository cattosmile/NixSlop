+#[derive(Debug, Clone, Copy)]
+pub(crate) struct CaptureCoordinateContract {
+    pub(crate) monitor_count: usize,
+    pub(crate) origin: [i32; 2],
+    pub(crate) scale: f64,
+}
+
+impl CaptureCoordinateContract {
+    fn layout(self) -> HyprlandCaptureLayout {
+        HyprlandCaptureLayout {
+            origin_x: self.origin[0],
+            origin_y: self.origin[1],
+            scale: self.scale,
+        }
+    }
+}
+
+fn capture_coordinate_contract_from_json(
+    monitors_json: &[u8],
+) -> Result<CaptureCoordinateContract> {
+    let monitors: Vec<HyprlandMonitor> = serde_json::from_slice(monitors_json)
+        .context("failed to parse hyprctl monitors -j for coordinate conversion")?;
+    let layout = HyprlandCaptureLayout::from_monitors(&monitors)
+        .ok_or_else(|| anyhow::anyhow!("Hyprland monitor metadata has no usable scale"))?;
+    Ok(CaptureCoordinateContract {
+        monitor_count: monitors.len(),
+        origin: [layout.origin_x, layout.origin_y],
+        scale: layout.scale,
+    })
+}
+
+pub(crate) fn capture_coordinate_contract() -> Result<CaptureCoordinateContract> {
+    let output = hyprctl_output(&["monitors", "-j"])
+        .context("failed to run hyprctl monitors -j for coordinate diagnostics")?;
+    if !output.status.success() {
+        bail!(
+            "hyprctl monitors -j failed: {}",
+            String::from_utf8_lossy(&output.stderr).trim()
+        );
+    }
+    capture_coordinate_contract_from_json(&output.stdout)
+}
+
