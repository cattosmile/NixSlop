+pub(crate) fn select_replacement_window_for_target(
+    target: &WindowTarget,
+    candidates: &[WindowInfo],
+) -> Option<WindowInfo> {
+    let requested_window_id = target.window_id?;
+    let candidates = candidates
+        .iter()
+        .filter(|candidate| candidate.window_id != requested_window_id)
+        .filter(|candidate| candidate.backend == HYPRLAND_BACKEND)
+        .collect::<Vec<_>>();
+
+    if let Some(pid) = target.pid {
