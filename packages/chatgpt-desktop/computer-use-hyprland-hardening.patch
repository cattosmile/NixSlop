+            .iter()
+            .copied()
+            .filter(|candidate| candidate.pid == Some(pid))
+            .filter(|candidate| same_target_identity(target, candidate))
+            .collect::<Vec<_>>();
+        if identity_matches.len() > 1 {
+            identity_matches.retain(|candidate| target.title == candidate.title);
+        }
+        if identity_matches.len() == 1 {
+            return Some(identity_matches[0].clone());
+        }
+    }
