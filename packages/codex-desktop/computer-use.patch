+/// Additional lookup locations for Electron-launched processes whose PATH
+/// does not include the interactive shell's Nix profiles.
+fn nix_profile_candidates(command: &str) -> Vec<PathBuf> {
+    let mut candidates = Vec::new();
+    if let Some(home) = env::var_os("HOME").map(PathBuf::from) {
+        candidates.extend([
+            home.join(".nix-profile/bin").join(command),
+            home.join(".local/state/nix/profile/bin").join(command),
+            home.join(".local/share/nix/profile/bin").join(command),
+        ]);
+    }
+    if let Some(user) = env::var_os("USER") {
+        candidates.push(
+            PathBuf::from("/etc/profiles/per-user")
+                .join(user)
+                .join("bin")
+                .join(command),
+        );
+    }
+    candidates.extend([
+        PathBuf::from("/run/current-system/sw/bin").join(command),
+        PathBuf::from("/run/wrappers/bin").join(command),
+    ]);
+    candidates
 }
 
