+/// Resolve a command from both the inherited GUI PATH and the common Nix
+/// profile locations. Electron-launched processes often do not inherit the
+/// interactive shell PATH, so native backends must not rely on `Command::new`
+/// doing the lookup for them.
+pub(crate) fn resolve_command(command: &str) -> Option<PathBuf> {
+    let requested = Path::new(command);
+    if requested.is_absolute() {
+        return requested.is_file().then(|| requested.to_path_buf());
+    }
+
+    let mut candidates = Vec::new();
+    if let Some(path) = env::var_os("PATH") {
+        candidates.extend(env::split_paths(&path).map(|dir| dir.join(command)));
+    }
+    if let Some(home) = env::var_os("HOME").map(PathBuf::from) {
+        candidates.extend([
+            home.join(".nix-profile/bin").join(command),
+            home.join(".local/state/nix/profile/bin").join(command),
+            home.join(".local/share/nix/profile/bin").join(command),
+        ]);
+    }
+    if let Some(user) = env::var_os("USER") {
+        candidates.push(
+            PathBuf::from("/etc/profiles/per-user")
+                .join(user)
+                .join("bin")
+                .join(command),
+        );
+    }
+    candidates.extend([
+        PathBuf::from("/run/current-system/sw/bin").join(command),
+        PathBuf::from("/run/wrappers/bin").join(command),
+        PathBuf::from("/usr/local/bin").join(command),
+        PathBuf::from("/usr/bin").join(command),
+        PathBuf::from("/bin").join(command),
+    ]);
+    candidates.into_iter().find(|path| path.is_file())
 }
 
