+pub async fn move_window(window_id: u64, x: i32, y: i32) -> Result<String> {
+    dispatch_window_pixel("move", "movewindowpixel", x, y, window_id)
+        .await
+        .map(|()| format!("Hyprland moved window 0x{window_id:x} to {x},{y}."))
+}
+
+pub async fn resize_window(window_id: u64, width: i32, height: i32) -> Result<String> {
+    if width <= 0 || height <= 0 {
+        bail!("Hyprland window size must be positive, got {width}x{height}");
+    }
+    dispatch_window_pixel("resize", "resizewindowpixel", width, height, window_id)
+        .await
+        .map(|()| format!("Hyprland resized window 0x{window_id:x} to {width}x{height}."))
+}
+
+async fn dispatch_window_pixel(
+    lua_dispatcher: &str,
+    legacy_dispatcher: &str,
+    x: i32,
+    y: i32,
+    window_id: u64,
+) -> Result<()> {
+    let address = format!("address:0x{window_id:x}");
+    let lua_dispatch = lua_pixel_dispatch(lua_dispatcher, x, y, &address);
+    let lua_output = hyprctl_output_async(&["dispatch", &lua_dispatch])
+        .await
+        .with_context(|| {
+            format!("failed to run Hyprland Lua {lua_dispatcher} dispatcher for {address}")
+        })?;
+    if dispatch_succeeded(&lua_output) {
+        return Ok(());
+    }
+
+    let legacy_parameters = format!("exact {x} {y},{address}");
+    let legacy_output =
+        hyprctl_output_async(&["dispatch", legacy_dispatcher, &legacy_parameters])
+            .await
+            .with_context(|| {
+                format!("failed to run hyprctl dispatch {legacy_dispatcher} for {address}")
+            })?;
+    if dispatch_succeeded(&legacy_output) {
+        return Ok(());
+    }
+
+    bail!(
+        "Hyprland {lua_dispatcher} failed for {address}; Lua dispatcher: {}; legacy dispatcher: {}",
+        command_detail(&lua_output),
+        command_detail(&legacy_output)
+    )
+}
+
+fn lua_pixel_dispatch(dispatcher: &str, x: i32, y: i32, address: &str) -> String {
+    format!(
+        "hl.dsp.window.{dispatcher}({{ x = {x}, y = {y}, relative = false, window = \"{address}\" }})"
+    )
+}
+
